#!/usr/bin/env bash
#PBS -N amsc-nbody-test
#PBS -q gpu
#PBS -l select=1:ncpus=2:ngpus=1
#PBS -l walltime=00:30:00
#PBS -j oe

set -euo pipefail

SOURCE_DIR="${SOURCE_DIR:-${PBS_O_WORKDIR:-$PWD}}"
IMAGE_PATH="${IMAGE_PATH:-${SOURCE_DIR}/nbody-tests.sif}"
RESULTS_DIR="${RESULTS_DIR:-${SOURCE_DIR}/ci-results/${PBS_JOBID:-manual}}"
CUDA_ARCHITECTURES="${CUDA_ARCHITECTURES:-89}"
NBODY_ENABLE_COMPUTE_SANITIZER_TESTS="${NBODY_ENABLE_COMPUTE_SANITIZER_TESTS:-OFF}"
CONTAINER_RUNTIME="${CONTAINER_RUNTIME:-apptainer}"
BUILD_JOBS="${BUILD_JOBS:-2}"

if [[ -n "${CONTAINER_MODULE:-}" ]]; then
    if ! type module >/dev/null 2>&1 && [[ -r /etc/profile ]]; then
        source /etc/profile
    fi
    module load "${CONTAINER_MODULE}"
fi

if ! command -v "${CONTAINER_RUNTIME}" >/dev/null 2>&1; then
    if [[ "${CONTAINER_RUNTIME}" == "apptainer" ]] && command -v singularity >/dev/null 2>&1; then
        CONTAINER_RUNTIME="singularity"
    else
        echo "Container runtime not found: ${CONTAINER_RUNTIME}" >&2
        exit 1
    fi
fi

if [[ ! -d "${SOURCE_DIR}" ]]; then
    echo "Source directory not found: ${SOURCE_DIR}" >&2
    exit 1
fi

if [[ ! -f "${IMAGE_PATH}" ]]; then
    echo "Container image not found: ${IMAGE_PATH}" >&2
    exit 1
fi

mkdir -p "${RESULTS_DIR}"

record_exit_status() {
    local status=$?
    set +e
    printf '%s\n' "${status}" > "${RESULTS_DIR}/pbs-exit-code"
}
trap record_exit_status EXIT

SCRATCH_ROOT="${TMPDIR:-/scratch_local}"
BUILD_DIR="${SCRATCH_ROOT}/amsc-nbody-${PBS_JOBID:-manual}"
mkdir -p "${BUILD_DIR}"

container_exec=(
    "${CONTAINER_RUNTIME}"
    exec
    --nv
    --cleanenv
)

if [[ -n "${CUDA_VISIBLE_DEVICES:-}" ]]; then
    container_exec+=(--env "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES}")
fi

container_exec+=(
    --bind "${SOURCE_DIR}:/workspace:ro"
    --bind "${BUILD_DIR}:/build"
    --bind "${RESULTS_DIR}:/results"
    "${IMAGE_PATH}"
)

printf 'PBS job: %s\n' "${PBS_JOBID:-manual}"
printf 'GPU node: %s\n' "$(hostname)"
"${container_exec[@]}" nvidia-smi

"${container_exec[@]}" cmake \
    -S /workspace \
    -B /build \
    -G Ninja \
    -DBUILD_TESTING=ON \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo \
    -DCMAKE_CUDA_ARCHITECTURES="${CUDA_ARCHITECTURES}" \
    -DNBODY_ENABLE_COMPUTE_SANITIZER_TESTS="${NBODY_ENABLE_COMPUTE_SANITIZER_TESTS}" \
    2>&1 | tee "${RESULTS_DIR}/configure.log"

"${container_exec[@]}" cmake \
    --build /build \
    --parallel "${BUILD_JOBS}" \
    2>&1 | tee "${RESULTS_DIR}/build.log"

"${container_exec[@]}" ctest \
    --test-dir /build \
    --parallel 1 \
    --output-on-failure \
    --output-junit /results/ctest-results.xml \
    2>&1 | tee "${RESULTS_DIR}/ctest.log"
