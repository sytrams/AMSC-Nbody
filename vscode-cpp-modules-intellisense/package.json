{
  "name": "cpp-modules-intellisense",
  "displayName": "C++ Modules IntelliSense",
  "description": "clangd-backed IntelliSense for modern C++ with first-class setup for C++20/23 modules.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "c++",
    "clangd",
    "intellisense",
    "modules",
    "cppm",
    "ixx"
  ],
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:cuda",
    "onLanguage:cuda-cpp",
    "onLanguage:objective-c",
    "onLanguage:objective-cpp",
    "onCommand:cppModulesIntellisense.restartLanguageServer",
    "onCommand:cppModulesIntellisense.configureWorkspaceForModules",
    "onCommand:cppModulesIntellisense.createClangdConfig"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cppModulesIntellisense.restartLanguageServer",
        "title": "C++ Modules IntelliSense: Restart Language Server"
      },
      {
        "command": "cppModulesIntellisense.configureWorkspaceForModules",
        "title": "C++ Modules IntelliSense: Configure Workspace for Modules"
      },
      {
        "command": "cppModulesIntellisense.createClangdConfig",
        "title": "C++ Modules IntelliSense: Create .clangd Template"
      }
    ],
    "configuration": {
      "title": "C++ Modules IntelliSense",
      "properties": {
        "cppModulesIntellisense.clangd.path": {
          "type": "string",
          "default": "clangd",
          "description": "Path to the clangd executable."
        },
        "cppModulesIntellisense.clangd.arguments": {
          "type": "array",
          "default": [
            "--background-index",
            "--clang-tidy",
            "--completion-style=detailed",
            "--header-insertion=iwyu",
            "--pch-storage=memory"
          ],
          "items": {
            "type": "string"
          },
          "description": "Additional arguments passed to clangd."
        },
        "cppModulesIntellisense.clangd.fallbackFlags": {
          "type": "array",
          "default": [
            "-std=c++23"
          ],
          "items": {
            "type": "string"
          },
          "description": "Flags sent to clangd when no compile command is available."
        },
        "cppModulesIntellisense.clangd.compilationDatabasePath": {
          "type": "string",
          "default": "",
          "description": "Optional path to the directory that contains compile_commands.json."
        },
        "cppModulesIntellisense.clangd.queryDriver": {
          "type": "string",
          "default": "",
          "description": "Optional --query-driver glob passed to clangd for non-clang toolchains."
        },
        "cppModulesIntellisense.modules.fileExtensions": {
          "type": "array",
          "default": [
            "*.cppm",
            "*.ixx",
            "*.mpp",
            "*.mxx",
            "*.ccm",
            "*.cxxm"
          ],
          "items": {
            "type": "string"
          },
          "description": "Workspace file patterns that should be associated with the cpp language."
        },
        "cppModulesIntellisense.modules.languageStandard": {
          "type": "string",
          "default": "c++23",
          "enum": [
            "c++20",
            "c++23",
            "c++26"
          ],
          "description": "Language standard used by the generated .clangd template and default fallback flags."
        },
        "cppModulesIntellisense.modules.suppressDiagnostics": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, the generated .clangd template suppresses clangd diagnostics for module interface and implementation unit files."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.3.2",
    "typescript": "^5.8.3"
  }
}
