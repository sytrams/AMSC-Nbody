Bootstrap: docker
From: nvidia/cuda:12.6.3-devel-ubuntu24.04

%labels
    org.opencontainers.image.title "AMSC N-body NVIDIA test environment"
    org.opencontainers.image.description "CUDA, CMake and GoogleTest test container"
    org.opencontainers.image.version "1.0"

%post
    set -eux

    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        googletest \
        libgtest-dev \
        ninja-build \
        pkg-config

    # Install GoogleTest in a predictable, architecture-independent location.
    cmake \
        -S /usr/src/googletest \
        -B /tmp/googletest-build \
        -G Ninja \
        -DBUILD_GMOCK=OFF \
        -DINSTALL_GTEST=ON \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local

    cmake --build /tmp/googletest-build
    cmake --install /tmp/googletest-build

    rm -rf \
        /tmp/googletest-build \
        /var/lib/apt/lists/*

    ldconfig

%environment
    export CUDA_HOME=/usr/local/cuda
    export PATH=/usr/local/cuda/bin:${PATH}
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH:-}

    export CC=gcc
    export CXX=g++
    export CUDACXX=/usr/local/cuda/bin/nvcc

    export GTEST_ROOT=/usr/local

%help
    This image is the isolated NVIDIA test environment for AMSC N-body.
    It does not connect to the cluster and contains no VPN or SSH tooling.

    Expose the NVIDIA driver when running CUDA commands:
        apptainer exec --nv nbody-tests.sif <command>

    The repository's ci/run_gpu_tests.pbs script supplies the source, build,
    and results bind mounts and runs the complete CTest suite.

%runscript
    if [ "$#" -eq 0 ]; then
        exec /bin/bash
    fi

    exec "$@"

%test
    command -v gcc
    command -v g++
    command -v cmake
    command -v ninja
    command -v nvcc

    nvcc --version

    test -f /usr/local/include/gtest/gtest.h
    test -f /usr/local/lib/libgtest.a
    test -f /usr/local/lib/libgtest_main.a
